{
  "manifest_version": 3,
  "name": "AudioEX",
  "version": "1.1.1",
  "description": "Per-tab equalizer, soft limiter, volume boost, and mono controls.",
  "author": "vorvek",
  "homepage_url": "https://github.com/vorvek/AudioEX",
  "icons": {
    "16": "icons/audioex-16.png",
    "32": "icons/audioex-32.png",
    "48": "icons/audioex-48.png",
    "128": "icons/audioex-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/audioex-16.png",
      "32": "icons/audioex-32.png",
      "48": "icons/audioex-48.png",
      "128": "icons/audioex-128.png"
    },
    "default_title": "AudioEX"
  }
}
